FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
# 完整内核镜像：完整 chrome + Xvfb/VNC/noVNC 栈，VNC 与 CDP 抓屏两种画面都可用。
ENV BROWSER_MODE=full

# Chrome for Testing：Google 官方为自动化测试发布的固定版本，无自动更新。
# 升级浏览器时只改 CHROME_VERSION；若需同步升级无头内核，
# 记得同步修改 Dockerfile.browser-headless 里的同名参数。
ARG CHROME_VERSION=158.0.8127.88

# 精简说明（只删确认无用的部分，绝不碰启动必需文件）：
#   - locales 只留 en-US / zh-CN，删掉其余语言包约 48 MB（不影响启动）
#   - WidevineCdm 是 DRM 组件，自动化用不到，约 21 MB（不影响启动）
#   - 字体用文泉驿微米黑（5 MB）替代 Noto CJK（91 MB）
#   - 必须保留 SwiftShader / libEGL / libGLESv2：即使 --disable-gpu，
#     WebGL 仍由它们提供，删掉会变成 NO_WEBGL（已实测）
#   - 必须保留 chrome_crashpad_handler：Linux Chrome 启动会 exec 它，
#     文件缺失会直接 FATAL 崩溃（Chromium issue 40115742）
#   - 下面 libxkbcommon0 / libudev1 / libatspi2.0-0 必须【显式】安装：
#     它们是 chrome 的 DT_NEEDED 动态库，之前靠传递依赖装进来，
#     一旦 apt autoremove 就会变成孤儿被删，导致浏览器起不来。
#     显式安装后会被 apt 标记为 manual，autoremove 不会误删。
# 关闭 --no-sandbox 的 "unsupported command-line flag" 警告条：
# Chrome 76+ 已忽略 --disable-infobars，只能由管理策略关闭。
# 同时写 chromium 路径，兼容部分构建变体；文件极小，不影响镜像体积。
RUN mkdir -p /etc/opt/chrome/policies/managed /etc/chromium/policies/managed \
 && printf '%s\n' '{"CommandLineFlagSecurityWarningsEnabled": false}' \
      > /etc/opt/chrome/policies/managed/cdp_browser_manager.json \
 && cp /etc/opt/chrome/policies/managed/cdp_browser_manager.json \
      /etc/chromium/policies/managed/cdp_browser_manager.json

# 安装、下载、精简、卸载构建工具必须在同一层，分层删不会减小镜像。
RUN apt update \
 && apt install -y --no-install-recommends \
      ca-certificates curl unzip procps fontconfig \
      libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 \
      libc6 libcairo2 libcups2 libdbus-1-3 libexpat1 libfontconfig1 \
      libgbm1 libgcc-s1 libglib2.0-0 libnspr4 libnss3 \
      libpango-1.0-0 libpangocairo-1.0-0 libstdc++6 libudev1 \
      libx11-6 libx11-xcb1 libxcb1 libxcomposite1 libxcursor1 \
      libxdamage1 libxext6 libxfixes3 libxi6 libxkbcommon0 \
      libxrandr2 libxrender1 libxss1 libxtst6 \
      xvfb x11vnc novnc websockify socat fonts-wqy-microhei \
 && curl -fsSL \
      "https://storage.googleapis.com/chrome-for-testing-public/${CHROME_VERSION}/linux64/chrome-linux64.zip" \
      -o /tmp/chrome.zip \
 && unzip -q /tmp/chrome.zip -d /opt \
 && rm -f /tmp/chrome.zip \
 && chmod +x /opt/chrome-linux64/chrome /opt/chrome-linux64/chrome_crashpad_handler \
 && ln -sf /opt/chrome-linux64/chrome /usr/bin/chrome \
 && find /opt/chrome-linux64/locales -maxdepth 1 -type f \
      ! -name 'en-US*' ! -name 'zh-CN*' -delete \
 && rm -rf /opt/chrome-linux64/WidevineCdm \
 && fc-cache -f \
 && apt purge -y curl unzip \
 && apt autoremove -y \
 && apt clean \
 && rm -rf /var/lib/apt/lists/* /usr/share/doc/* /usr/share/man/*

WORKDIR /app

COPY start.sh /app/start.sh
RUN sed -i 's/\r$//' /app/start.sh && chmod +x /app/start.sh

EXPOSE 9222 5900 6080

CMD ["/app/start.sh"]
