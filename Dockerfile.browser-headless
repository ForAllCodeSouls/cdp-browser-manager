FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
# 无头内核镜像：只装 chrome-headless-shell，不含 Xvfb/VNC/noVNC
ENV BROWSER_MODE=headless

# Chrome for Testing：与完整镜像同版本，只改这里即可单独升级无头内核。
# 若两个内核要一起升级，请同步修改 Dockerfile.browser 的 CHROME_VERSION。
ARG CHROME_VERSION=158.0.8127.88

# 保留完整 chrome 所需的系统库（headless-shell 同样依赖这些动态库），
# 但不再安装 xvfb / x11vnc / novnc / websockify —— 这是本镜像瘦身的关键。
RUN apt update && apt install -y --no-install-recommends \
    ca-certificates curl unzip procps \
    libasound2 libatk-bridge2.0-0 libatk1.0-0 libc6 libcairo2 libcups2 \
    libdbus-1-3 libexpat1 libfontconfig1 libgbm1 libglib2.0-0 \
    libnspr4 libnss3 libpango-1.0-0 libpangocairo-1.0-0 libstdc++6 \
    libx11-6 libx11-xcb1 libxcb1 libxcomposite1 libxcursor1 libxdamage1 \
    libxext6 libxfixes3 libxi6 libxrandr2 libxrender1 libxss1 libxtst6 \
    fonts-noto-cjk \
    && apt clean \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL \
      "https://storage.googleapis.com/chrome-for-testing-public/${CHROME_VERSION}/linux64/chrome-headless-shell-linux64.zip" \
      -o /tmp/shell.zip \
    && unzip -q /tmp/shell.zip -d /opt \
    && rm -f /tmp/shell.zip \
    && chmod +x /opt/chrome-headless-shell-linux64/chrome-headless-shell \
    && ln -sf /opt/chrome-headless-shell-linux64/chrome-headless-shell /usr/bin/chrome-headless-shell

WORKDIR /app

COPY start.sh /app/start.sh
RUN sed -i 's/\r$//' /app/start.sh && chmod +x /app/start.sh

# 无头内核只有 CDP，不暴露 VNC/noVNC 端口
EXPOSE 9222

CMD ["/app/start.sh"]
